# Anthropic API key for filtering/clustering/summarization (console.anthropic.com)
ANTHROPIC_API_KEY=

# twitterapi.io API key (twitterapi.io dashboard) — the tweet data source
TWITTERAPI_IO_KEY=

# Vercel Blob read-write token (Vercel dashboard > Storage > Blob).
# If unset, the pipeline writes to a local .data/ directory instead — fine for dev.
BLOB_READ_WRITE_TOKEN=

# Shared secret protecting the cron endpoint. Any long random string.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
