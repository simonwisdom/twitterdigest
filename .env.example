# OpenRouter API key for filtering/clustering/summarization (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Default model for every pipeline stage. The per-tier values are optional.
OPENROUTER_MODEL=google/gemini-3.7-flash
# OPENROUTER_MODEL_FAST=
# OPENROUTER_MODEL_SMART=

# twitterapi.io API key (twitterapi.io dashboard) — the tweet data source
TWITTERAPI_IO_KEY=
# Optional request spacing. The conservative default avoids entry-tier 429s.
TWITTERAPI_MIN_INTERVAL_MS=5000

# Optional local storage root. GitHub Actions sets this to the tracked data/ directory.
# DIGEST_DATA_DIR=data
